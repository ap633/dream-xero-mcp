# ─── Mode 1: Custom Connection (single Xero org) ────────────────────────────
# Used when XERO_OAUTH_CLIENT_ID is NOT set. Backwards-compatible with v1.x.
XERO_CLIENT_ID=your_xero_custom_connection_client_id
XERO_CLIENT_SECRET=your_xero_custom_connection_client_secret

# ─── Mode 2: OAuth 2.0 (multi-tenant — many Xero orgs) ──────────────────────
# When XERO_OAUTH_CLIENT_ID is set, the server runs in OAuth mode.
# Create a Web App at https://developer.xero.com/app/manage with redirect URI
# matching XERO_OAUTH_REDIRECT_URI below.
# XERO_OAUTH_CLIENT_ID=your_xero_oauth_app_client_id
# XERO_OAUTH_CLIENT_SECRET=your_xero_oauth_app_client_secret
# XERO_OAUTH_REDIRECT_URI=https://dream-xero-mcp-production.up.railway.app/callback

# ─── Optional ───────────────────────────────────────────────────────────────
# Override default scopes (space-separated). Leave unset for sensible defaults.
# XERO_SCOPES=offline_access accounting.transactions accounting.contacts ...

# Railway sets PORT automatically.
PORT=3000
